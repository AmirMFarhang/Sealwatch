{
  "name": "@amirmfarhang/trust-layer",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Receiver verification and wallet authorization for test dollars on RGB; private prototype",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "bin": {
    "trust": "bin/trust"
  },
  "scripts": {
    "trust": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "bitcoinjs-lib": "7.0.4",
    "@tetherto/wdk": "1.0.0-beta.19",
    "@utexo/wdk-wallet-rgb": "2.0.3",
    "@utexo/rgb-sdk": "1.0.3",
    "@utexo/rgb-lib": "0.3.0-beta.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
